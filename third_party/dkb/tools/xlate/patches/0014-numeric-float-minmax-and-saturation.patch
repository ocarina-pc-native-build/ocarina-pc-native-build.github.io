+            SpvInstruction infinity = context.Constant(uintType, isFP64
+                ? (SpvLiteralInteger)0x7ff0000000000000UL : (SpvLiteralInteger)0x7f800000U);
+            SpvInstruction zero = context.Constant(uintType, isFP64
+                ? (SpvLiteralInteger)0UL : (SpvLiteralInteger)0U);
+            SpvInstruction magnitudeMask = context.Not(uintType, sign);
+            SpvInstruction bitsA = context.Bitcast(uintType, a);
+            SpvInstruction bitsB = context.Bitcast(uintType, b);
+
+            SpvInstruction Key(SpvInstruction bits)
+            {
+                SpvInstruction negative = context.INotEqual(boolType, context.BitwiseAnd(uintType, bits, sign), zero);
+                return context.Select(uintType, negative, context.Not(uintType, bits), context.BitwiseXor(uintType, bits, sign));
+            }
+
