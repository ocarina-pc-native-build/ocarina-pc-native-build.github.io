+        private static bool ContainsLaneDependentOperation(IAstNode node)
+        {
+            if (node is not AstOperation operation)
+            {
+                return false;
+            }
+
+            switch (operation.Inst & Instruction.Mask)
+            {
+                case Instruction.Ballot:
+                case Instruction.Shuffle:
+                case Instruction.ShuffleDown:
+                case Instruction.ShuffleUp:
+                case Instruction.ShuffleXor:
+                case Instruction.VoteAll:
+                case Instruction.VoteAllEqual:
+                case Instruction.VoteAny:
+                    return true;
+            }
+
+            for (int index = 0; index < operation.SourcesCount; index++)
+            {
+                if (ContainsLaneDependentOperation(operation.GetSource(index)))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
