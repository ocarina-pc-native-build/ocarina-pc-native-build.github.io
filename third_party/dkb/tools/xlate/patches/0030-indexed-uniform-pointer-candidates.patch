+        // The values an integer expression can take, or null when they are not few and known. cyclic: the expression
+        // reached a value that is still being evaluated (a loop-carried phi).
+        private static HashSet<uint> EvaluateBounded(Operand value, int depth, HashSet<Operand> active, out bool cyclic)
+        {
+            const int MaxValues = 64;
+            cyclic = false;
+            if (value.Type == OperandType.Constant)
+            {
+                return [(uint)value.Value];
+            }
+            if (depth > 32)
+            {
+                return null;
+            }
+            if (!active.Add(value))
+            {
+                cyclic = true;
+                return null;
+            }
+
+            HashSet<uint> result = null;
+            if (value.AsgOp is PhiNode phi)
+            {
+                result = [];
+                for (int index = 0; index < phi.SourcesCount && result != null; index++)
+                {
+                    HashSet<uint> source = EvaluateBounded(phi.GetSource(index), depth + 1, active, out bool sourceCyclic);
+                    if (sourceCyclic)
+                    {
+                        cyclic = true;
+                        result = null;
+                    }
+                    else if (source != null)
+                    {
+                        result.UnionWith(source);
+                    }
+                }
+                if (result != null && (result.Count == 0 || result.Count > MaxValues))
+                {
+                    result = null;
+                }
+            }
+            else if (value.AsgOp is Operation operation && operation.SourcesCount == 2)
+            {
+                Func<uint, uint, uint> apply = operation.Inst switch
+                {
+                    Instruction.Add => (a, b) => a + b,
+                    Instruction.Subtract => (a, b) => a - b,
+                    Instruction.Multiply => (a, b) => a * b,
+                    Instruction.ShiftLeft => (a, b) => a << (int)(b & 31),
+                    Instruction.ShiftRightU32 => (a, b) => a >> (int)(b & 31),
+                    Instruction.BitwiseAnd => (a, b) => a & b,
+                    Instruction.BitwiseOr => (a, b) => a | b,
+                    _ => null,
+                };
+                if (apply != null)
+                {
+                    HashSet<uint> x = EvaluateBounded(operation.GetSource(0), depth + 1, active, out bool xCyclic);
+                    HashSet<uint> y = xCyclic ? null : EvaluateBounded(operation.GetSource(1), depth + 1, active, out cyclic);
+                    cyclic |= xCyclic;
+                    if (!cyclic && x != null && y != null)
+                    {
+                        result = [];
+                        foreach (uint a in x)
+                        {
+                            foreach (uint b in y)
+                            {
+                                result.Add(apply(a, b));
+                            }
+                        }
+                        if (result.Count > MaxValues)
+                        {
+                            result = null;
+                        }
+                    }
+                }
+            }
+
+            active.Remove(value);
+            return result;
+        }
