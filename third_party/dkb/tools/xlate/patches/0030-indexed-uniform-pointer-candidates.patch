+        // The words a constant-buffer load with a computed index can read, for a load built as EmitLoadConstant builds
+        // it: Load.ConstantBuffer(binding, 0, ShiftRightU32(w, 2), BitwiseAnd(w, 3)) with one word index w. w is
+        // evaluated over phis and constant integer arithmetic. A phi source that has no bounded value set (a thread
+        // ID, a loaded value) is left out: an address built from it matches no candidate, so the guarded access does
+        // nothing, as for any other unknown address. A phi that depends on itself (a loop counter) is not bounded.
+        private static bool TryGetIndexedConstantBufferWords(ResourceManager resourceManager, Operand value, out int slot, out List<uint> words)
+        {
+            slot = 0;
+            words = null;
+
+            static bool IsConstantValue(Operand operand, int expected)
+            {
+                return operand.Type == OperandType.Constant && operand.Value == expected;
+            }
+
+            if (value.AsgOp is not Operation load || load.Inst != Instruction.Load ||
+                load.StorageKind != StorageKind.ConstantBuffer || load.SourcesCount != 4 ||
+                load.GetSource(0).Type != OperandType.Constant || !IsConstantValue(load.GetSource(1), 0) ||
+                load.GetSource(2).AsgOp is not Operation vector || vector.Inst != Instruction.ShiftRightU32 ||
+                !IsConstantValue(vector.GetSource(1), 2) ||
+                load.GetSource(3).AsgOp is not Operation element || element.Inst != Instruction.BitwiseAnd ||
+                !IsConstantValue(element.GetSource(1), 3) || vector.GetSource(0) != element.GetSource(0) ||
+                vector.GetSource(0).Type == OperandType.Constant ||
+                !resourceManager.TryGetConstantBufferSlot(load.GetSource(0).Value, out slot))
+            {
+                return false;
+            }
+
+            HashSet<uint> set = EvaluateBounded(vector.GetSource(0), 0, [], out _);
+            if (set == null)
+            {
+                return false;
+            }
+
+            words = set.Where(word => word < 0x3fff).OrderBy(word => word).ToList();
+            return words.Count != 0;
+        }
